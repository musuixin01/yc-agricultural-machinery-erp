generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  MACHINE
  PART
  STANDARD_PART
  CONSUMABLE
  SERVICE
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

enum PartyRoleType {
  CUSTOMER
  SUPPLIER
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  LOCKED
  INACTIVE
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum InventoryDocumentType {
  OPENING
  INITIAL_STOCK
}

enum InventoryDocumentStatus {
  DRAFT
  SUBMITTED
  POSTED
  REVERSED
  CANCELLED
}

enum InventoryStocktakeStatus {
  DRAFT
  SUBMITTED
  POSTED
  CANCELLED
}

enum InventoryDamageStatus {
  DRAFT
  SUBMITTED
  POSTED
  CANCELLED
}

enum InventoryDamageReason {
  DAMAGED
  RUSTED
  OBSOLETE
  OTHER
}

enum PurchaseDocumentStatus {
  DRAFT
  SUBMITTED
  POSTED
  REVERSED
  CANCELLED
}

enum SalesDocumentStatus {
  DRAFT
  SUBMITTED
  POSTED
  REVERSED
  CANCELLED
}

enum SalesSettlementType {
  IMMEDIATE
  CREDIT
}

enum ReceivableEntryStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  REVERSED
}

enum PayableEntryStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  REVERSED
}

enum CashAccountType {
  CASH
  BANK
  WECHAT
  ALIPAY
  OTHER
}

enum CashAccountStatus {
  ACTIVE
  INACTIVE
}

enum SupplierPaymentStatus {
  DRAFT
  SUBMITTED
  POSTED
  REVERSED
  CANCELLED
}

enum ReceiptPaperSize {
  A4
  RECEIPT_80MM
}

model User {
  id                                String                       @id @default(uuid()) @db.Uuid
  username                          String                       @unique @db.VarChar(64)
  displayName                       String                       @map("display_name") @db.VarChar(80)
  passwordHash                      String                       @map("password_hash") @db.VarChar(512)
  status                            UserStatus                   @default(ACTIVE)
  failedLoginCount                  Int                          @default(0) @map("failed_login_count")
  lockedUntil                       DateTime?                    @map("locked_until") @db.Timestamptz(3)
  lastLoginAt                       DateTime?                    @map("last_login_at") @db.Timestamptz(3)
  version                           Int                          @default(1)
  createdAt                         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles                             UserRole[]
  sessions                          AuthSession[]
  auditEvents                       AuditEvent[]
  createdInventoryDocuments         InventoryDocument[]          @relation("InventoryDocumentCreatedBy")
  submittedInventoryDocuments       InventoryDocument[]          @relation("InventoryDocumentSubmittedBy")
  postedInventoryDocuments          InventoryDocument[]          @relation("InventoryDocumentPostedBy")
  postedInventoryEntries            InventoryLedgerEntry[]       @relation("InventoryLedgerPostedBy")
  createdInventoryStocktakes        InventoryStocktake[]         @relation("InventoryStocktakeCreatedBy")
  submittedInventoryStocktakes      InventoryStocktake[]         @relation("InventoryStocktakeSubmittedBy")
  postedInventoryStocktakes         InventoryStocktake[]         @relation("InventoryStocktakePostedBy")
  createdInventoryDamages           InventoryDamageDocument[]    @relation("InventoryDamageCreatedBy")
  submittedInventoryDamages         InventoryDamageDocument[]    @relation("InventoryDamageSubmittedBy")
  postedInventoryDamages            InventoryDamageDocument[]    @relation("InventoryDamagePostedBy")
  createdPurchaseDocuments          PurchaseDocument[]           @relation("PurchaseDocumentCreatedBy")
  submittedPurchaseDocuments        PurchaseDocument[]           @relation("PurchaseDocumentSubmittedBy")
  postedPurchaseDocuments           PurchaseDocument[]           @relation("PurchaseDocumentPostedBy")
  postedPurchaseReturns             PurchaseReturn[]             @relation("PurchaseReturnPostedBy")
  postedPayableEntries              PayableEntry[]               @relation("PayableEntryPostedBy")
  createdSupplierPayments           SupplierPayment[]            @relation("SupplierPaymentCreatedBy")
  submittedSupplierPayments         SupplierPayment[]            @relation("SupplierPaymentSubmittedBy")
  postedSupplierPayments            SupplierPayment[]            @relation("SupplierPaymentPostedBy")
  postedPaymentReversals            SupplierPaymentReversal[]    @relation("SupplierPaymentReversalPostedBy")
  postedSupplierAdvances            SupplierAdvancePayment[]     @relation("SupplierAdvancePaymentPostedBy")
  postedAdvanceApplications         SupplierAdvanceApplication[] @relation("SupplierAdvanceApplicationPostedBy")
  postedCashLedgerEntries           CashLedgerEntry[]            @relation("CashLedgerPostedBy")
  createdCashAccounts               CashAccount[]                @relation("CashAccountCreatedBy")
  createdSalesDocuments             SalesDocument[]              @relation("SalesDocumentCreatedBy")
  submittedSalesDocuments           SalesDocument[]              @relation("SalesDocumentSubmittedBy")
  postedSalesDocuments              SalesDocument[]              @relation("SalesDocumentPostedBy")
  postedReceivableEntries           ReceivableEntry[]            @relation("ReceivableEntryPostedBy")
  postedCustomerReceipts            CustomerReceipt[]            @relation("CustomerReceiptPostedBy")
  postedReceiptReversals            CustomerReceiptReversal[]    @relation("CustomerReceiptReversalPostedBy")
  postedCustomerAdvances            CustomerAdvanceReceipt[]     @relation("CustomerAdvanceReceiptPostedBy")
  postedCustomerAdvanceApplications CustomerAdvanceApplication[] @relation("CustomerAdvanceApplicationPostedBy")
  postedCashTransfers               CashTransfer[]               @relation("CashTransferPostedBy")
  postedSalesReturns                SalesReturn[]                @relation("SalesReturnPostedBy")
  postedSalesReversals              SalesReversal[]              @relation("SalesReversalPostedBy")
  updatedBusinessProfiles           BusinessProfile[]            @relation("BusinessProfileUpdatedBy")

  @@index([status, username])
  @@map("users")
}

model BusinessProfile {
  id               String           @id @db.VarChar(32)
  storeName        String           @map("store_name") @db.VarChar(80)
  shortName        String           @map("short_name") @db.VarChar(20)
  phone            String?          @db.VarChar(30)
  address          String?          @db.VarChar(200)
  receiptFooter    String?          @map("receipt_footer") @db.VarChar(300)
  defaultPaperSize ReceiptPaperSize @default(A4) @map("default_paper_size")
  version          Int              @default(1)
  updatedById      String?          @map("updated_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        User?            @relation("BusinessProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("business_profiles")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(240)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(240)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(3)
  refreshExpiresAt DateTime  @map("refresh_expires_at") @db.Timestamptz(3)
  deviceName       String?   @map("device_name") @db.VarChar(120)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      String      @db.VarChar(100)
  entityType  String      @map("entity_type") @db.VarChar(80)
  entityId    String?     @map("entity_id") @db.VarChar(100)
  result      AuditResult
  ipAddress   String?     @map("ip_address") @db.VarChar(64)
  metadata    Json        @default("{}") @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model Warehouse {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique @db.VarChar(32)
  name                String                    @unique @db.VarChar(100)
  address             String?                   @db.VarChar(240)
  notes               String?                   @db.VarChar(500)
  isDefault           Boolean                   @default(false) @map("is_default")
  status              WarehouseStatus           @default(ACTIVE)
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  locations           WarehouseLocation[]
  inventoryDocuments  InventoryDocument[]
  inventoryEntries    InventoryLedgerEntry[]
  inventoryBalances   InventoryBalance[]
  inventoryStocktakes InventoryStocktake[]
  inventoryDamages    InventoryDamageDocument[]
  purchaseDocuments   PurchaseDocument[]
  purchaseReturns     PurchaseReturn[]
  salesDocuments      SalesDocument[]
  salesReturns        SalesReturn[]

  @@index([status, name])
  @@map("warehouses")
}

model WarehouseLocation {
  id                     String                  @id @default(uuid()) @db.Uuid
  warehouseId            String                  @map("warehouse_id") @db.Uuid
  code                   String                  @db.VarChar(32)
  name                   String                  @db.VarChar(100)
  description            String?                 @db.VarChar(240)
  status                 WarehouseStatus         @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryDocumentLines InventoryDocumentLine[]
  inventoryEntries       InventoryLedgerEntry[]

  @@unique([warehouseId, code])
  @@index([warehouseId, status])
  @@map("warehouse_locations")
}

model Party {
  id                       String                    @id @default(uuid()) @db.Uuid
  code                     String                    @unique @db.VarChar(48)
  name                     String                    @db.VarChar(160)
  shortName                String?                   @map("short_name") @db.VarChar(80)
  mnemonicCode             String?                   @map("mnemonic_code") @db.VarChar(80)
  taxId                    String?                   @unique @map("tax_id") @db.VarChar(32)
  identityNumberEncrypted  String?                   @map("identity_number_encrypted") @db.Text
  identityNumberHash       String?                   @unique @map("identity_number_hash") @db.Char(64)
  identityNumberLast4      String?                   @map("identity_number_last4") @db.Char(4)
  portraitImage            Bytes?                    @map("portrait_image") @db.ByteA
  portraitMimeType         String?                   @map("portrait_mime_type") @db.VarChar(40)
  creditLimit              Decimal                   @default(0) @map("credit_limit") @db.Decimal(19, 4)
  paymentTermsDays         Int                       @default(0) @map("payment_terms_days")
  paymentTermsMonths       Int                       @default(0) @map("payment_terms_months")
  province                 String?                   @db.VarChar(60)
  city                     String?                   @db.VarChar(60)
  address                  String?                   @db.VarChar(240)
  notes                    String?                   @db.VarChar(1000)
  status                   PartyStatus               @default(ACTIVE)
  version                  Int                       @default(1)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles                    PartyRole[]
  contacts                 PartyContact[]
  purchaseDocuments        PurchaseDocument[]
  purchaseReturns          PurchaseReturn[]
  payableEntries           PayableEntry[]
  supplierPayments         SupplierPayment[]
  supplierPaymentReversals SupplierPaymentReversal[]
  supplierAdvances         SupplierAdvancePayment[]
  salesDocuments           SalesDocument[]
  receivableEntries        ReceivableEntry[]
  customerReceipts         CustomerReceipt[]
  customerReceiptReversals CustomerReceiptReversal[]
  customerAdvances         CustomerAdvanceReceipt[]
  salesReturns             SalesReturn[]

  @@index([name])
  @@index([mnemonicCode])
  @@index([status, updatedAt])
  @@map("parties")
}

model PartyRole {
  id        String        @id @default(uuid()) @db.Uuid
  partyId   String        @map("party_id") @db.Uuid
  type      PartyRoleType
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  party     Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, type])
  @@index([type, partyId])
  @@map("party_roles")
}

model PartyContact {
  id        String   @id @default(uuid()) @db.Uuid
  partyId   String   @map("party_id") @db.Uuid
  name      String   @db.VarChar(80)
  phone     String?  @db.VarChar(32)
  email     String?  @db.VarChar(160)
  position  String?  @db.VarChar(80)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([phone])
  @@map("party_contacts")
}

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique @db.VarChar(32)
  name      String            @db.VarChar(80)
  parentId  String?           @map("parent_id") @db.Uuid
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]

  @@map("product_categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(32)
  name      String    @unique @db.VarChar(80)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("brands")
}

model Unit {
  id              String                  @id @default(uuid()) @db.Uuid
  code            String                  @unique @db.VarChar(24)
  name            String                  @unique @db.VarChar(40)
  decimalScale    Int                     @default(0) @map("decimal_scale")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  products        Product[]
  fromConversions ProductUnitConversion[] @relation("FromUnit")
  toConversions   ProductUnitConversion[] @relation("ToUnit")

  @@map("units")
}

model Product {
  id                      String                   @id @default(uuid()) @db.Uuid
  code                    String                   @unique @db.VarChar(48)
  name                    String                   @db.VarChar(160)
  mnemonicCode            String?                  @map("mnemonic_code") @db.VarChar(80)
  type                    ProductType
  model                   String?                  @db.VarChar(120)
  specification           String?                  @db.VarChar(240)
  categoryId              String                   @map("category_id") @db.Uuid
  brandId                 String?                  @map("brand_id") @db.Uuid
  baseUnitId              String                   @map("base_unit_id") @db.Uuid
  retailPrice             Decimal                  @default(0) @map("retail_price") @db.Decimal(19, 4)
  wholesalePrice          Decimal                  @default(0) @map("wholesale_price") @db.Decimal(19, 4)
  defaultPurchasePrice    Decimal                  @default(0) @map("default_purchase_price") @db.Decimal(19, 4)
  minimumSalePrice        Decimal                  @default(0) @map("minimum_sale_price") @db.Decimal(19, 4)
  safetyStock             Decimal                  @default(0) @map("safety_stock") @db.Decimal(19, 6)
  attributes              Json                     @default("{}") @db.JsonB
  status                  ProductStatus            @default(ACTIVE)
  version                 Int                      @default(1)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  category                ProductCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                   Brand?                   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  baseUnit                Unit                     @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  barcodes                ProductBarcode[]
  unitConversions         ProductUnitConversion[]
  inventoryDocumentLines  InventoryDocumentLine[]
  inventoryEntries        InventoryLedgerEntry[]
  inventoryBalances       InventoryBalance[]
  inventoryStocktakeLines InventoryStocktakeLine[]
  inventoryDamageLines    InventoryDamageLine[]
  purchaseLines           PurchaseLine[]
  purchaseReturnLines     PurchaseReturnLine[]
  salesLines              SalesLine[]
  salesReturnLines        SalesReturnLine[]
  salesReversalLines      SalesReversalLine[]

  @@index([name])
  @@index([mnemonicCode])
  @@index([categoryId, status])
  @@map("products")
}

model InventoryDocument {
  id              String                    @id @default(uuid()) @db.Uuid
  documentNumber  String                    @unique @map("document_number") @db.VarChar(32)
  type            InventoryDocumentType     @default(OPENING)
  status          InventoryDocumentStatus   @default(DRAFT)
  businessDate    DateTime                  @map("business_date") @db.Date
  warehouseId     String                    @map("warehouse_id") @db.Uuid
  notes           String?                   @db.VarChar(500)
  version         Int                       @default(1)
  createdById     String                    @map("created_by_id") @db.Uuid
  submittedById   String?                   @map("submitted_by_id") @db.Uuid
  submittedAt     DateTime?                 @map("submitted_at") @db.Timestamptz(3)
  postedById      String?                   @map("posted_by_id") @db.Uuid
  postedAt        DateTime?                 @map("posted_at") @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse       Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy       User                      @relation("InventoryDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy     User?                     @relation("InventoryDocumentSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  postedBy        User?                     @relation("InventoryDocumentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines           InventoryDocumentLine[]
  postingRequests InventoryPostingRequest[]

  @@index([warehouseId, status])
  @@index([status, businessDate])
  @@map("inventory_documents")
}

model InventoryDocumentLine {
  id                  String             @id @default(uuid()) @db.Uuid
  documentId          String             @map("document_id") @db.Uuid
  productId           String             @map("product_id") @db.Uuid
  locationId          String?            @map("location_id") @db.Uuid
  productNameSnapshot String             @map("product_name_snapshot") @db.VarChar(160)
  unitNameSnapshot    String             @map("unit_name_snapshot") @db.VarChar(40)
  quantity            Decimal            @db.Decimal(19, 6)
  unitCost            Decimal            @map("unit_cost") @db.Decimal(19, 4)
  lineAmount          Decimal            @map("line_amount") @db.Decimal(19, 4)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  document            InventoryDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  location            WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([documentId, productId])
  @@index([productId])
  @@map("inventory_document_lines")
}

model InventoryLedgerEntry {
  id                   String             @id @default(uuid()) @db.Uuid
  sourceDocumentId     String             @map("source_document_id") @db.Uuid
  sourceDocumentLineId String             @unique @map("source_document_line_id") @db.Uuid
  sourceDocumentType   String             @default("OPENING") @map("source_document_type") @db.VarChar(40)
  productId            String             @map("product_id") @db.Uuid
  warehouseId          String             @map("warehouse_id") @db.Uuid
  locationId           String?            @map("location_id") @db.Uuid
  quantityChange       Decimal            @map("quantity_change") @db.Decimal(19, 6)
  unitCost             Decimal            @map("unit_cost") @db.Decimal(19, 4)
  costAmount           Decimal            @map("cost_amount") @db.Decimal(19, 4)
  businessDate         DateTime           @map("business_date") @db.Date
  postedById           String             @map("posted_by_id") @db.Uuid
  postedAt             DateTime           @default(now()) @map("posted_at") @db.Timestamptz(3)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse            Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location             WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  postedBy             User               @relation("InventoryLedgerPostedBy", fields: [postedById], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId, postedAt])
  @@index([sourceDocumentId])
  @@map("inventory_ledger_entries")
}

model InventoryStocktake {
  id              String                             @id @default(uuid()) @db.Uuid
  documentNumber  String                             @unique @map("document_number") @db.VarChar(32)
  status          InventoryStocktakeStatus           @default(DRAFT)
  businessDate    DateTime                           @map("business_date") @db.Date
  warehouseId     String                             @map("warehouse_id") @db.Uuid
  notes           String?                            @db.VarChar(500)
  version         Int                                @default(1)
  createdById     String                             @map("created_by_id") @db.Uuid
  submittedById   String?                            @map("submitted_by_id") @db.Uuid
  submittedAt     DateTime?                          @map("submitted_at") @db.Timestamptz(3)
  postedById      String?                            @map("posted_by_id") @db.Uuid
  postedAt        DateTime?                          @map("posted_at") @db.Timestamptz(3)
  createdAt       DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse       Warehouse                          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy       User                               @relation("InventoryStocktakeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy     User?                              @relation("InventoryStocktakeSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
