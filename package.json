{
  "name": "yc-agricultural-machinery-erp",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@yc-erp/client",
    "build": "npm run build --workspace=@yc-erp/client",
    "preview": "npm run preview --workspace=@yc-erp/client",
    "client": "npm run dev --workspace=@yc-erp/client",
    "client:build": "npm run build --workspace=@yc-erp/client",
    "lint": "prettier --check \"apps/client/src/**/*.{ts,tsx,css,json}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}