{
  "name": "yc-agricultural-machinery-erp",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @yc-erp/api --filter @yc-erp/client dev",
    "client": "pnpm --dir apps/client dev",
    "client:build": "pnpm --dir apps/client build",
    "api": "pnpm --dir apps/api start:dev",
    "api:build": "pnpm --dir apps/api build",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\"",
    "test": "pnpm -r test",
    "db:generate": "pnpm --dir apps/api prisma:generate",
    "db:migrate": "pnpm --dir apps/api prisma:migrate",
    "db:seed": "pnpm --dir apps/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
